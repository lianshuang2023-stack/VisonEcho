# Inject secrets through the deployment platform, not through the frontend.
ACCESS_MODE=hosted
PUBLIC_ORIGIN=https://visionecho.example.com
HOSTED_DATA_DIR=/srv/visionecho-data
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-terra
AZURE_SPEECH_KEY=
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_REGION=
MAX_VIDEO_SECONDS=600
MAX_UPLOAD_MB=500
