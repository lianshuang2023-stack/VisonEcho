# Copy to .env.local. Backend only: never prefix secret variables with VITE_.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
# Azure deployment name must match the deployment in your resource.
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-terra
AZURE_PROJECT_ENDPOINT=
# Speech key falls back to the OpenAI key for a shared Azure AI Services resource.
AZURE_SPEECH_KEY=
# Configure either an explicit Speech custom endpoint or the actual Speech region.
AZURE_SPEECH_REGION=
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_API_VERSION=2025-10-15
AZURE_SPEECH_VOICE=en-US-JennyNeural
# Generated narration language and source dialogue recognition are independent.
SPEECH_LANGUAGE=en-US
DIALOGUE_LANGUAGE=auto
MAX_VIDEO_SECONDS=600
MAX_UPLOAD_MB=500
