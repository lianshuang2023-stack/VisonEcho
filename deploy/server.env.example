# Copy to server.env on the server, chmod 600, then edit locally there.
# DOMAIN is a real DNS name only. Empty value intentionally prevents startup.
DOMAIN=
# A locally built image or an explicitly supplied private registry image tag.
VISIONECHO_IMAGE=visionecho:local
# Private Docker network only; change both together if the server already
# uses this subnet. Only Caddy's fixed address may supply forwarded headers.
VISIONECHO_SUBNET=172.30.88.0/24
CADDY_PRIVATE_IP=172.30.88.2

# ngrok alternative only; ignored by the Caddy Compose file. Keep the app and
# agent on distinct fixed host addresses, and change all three values together
# if this subnet conflicts. Only NGROK_PRIVATE_IP is a trusted proxy.
NGROK_SUBNET=172.30.89.0/24
NGROK_PRIVATE_IP=172.30.89.2
APP_PRIVATE_IP=172.30.89.3
# Add the assigned NGROK_DOMAIN and real NGROK_AUTHTOKEN only to server.env.

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-terra
AZURE_SPEECH_KEY=
# Configure a matching Speech endpoint or region.
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_REGION=
MAX_VIDEO_SECONDS=600
SPEECH_LANGUAGE=zh-CN
DIALOGUE_LANGUAGE=auto
AZURE_SPEECH_VOICE=zh-CN-XiaoxiaoNeural
